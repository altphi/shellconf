ksh() {
  local debug=0 image="nicolaka/netshoot"
  while [[ "$1" == -* ]]; do
    case "$1" in
    -d)
      debug=1
      shift
      ;;
    -i)
      shift
      image="$1"
      shift
      ;;
    *)
      echo "Usage: ksh [-d] [-i image] [query] [cmd]"
      return 1
      ;;
    esac
  done
  local pod ns cmd
  pod=$(kubectl get pods --all-namespaces --no-headers | fzf --query="${1:-}" | awk '{print $2, $1}')
  [[ -z "$pod" ]] && return 0
  ns=${pod#* }
  pod=${pod%% *}
  if ((debug)); then
    kubectl debug -it -n "$ns" "$pod" --profile=general --image="$image" -- "${2:-sh}"
  else
    kubectl exec -it -n "$ns" "$pod" -- "${2:-/bin/sh}"
  fi
}

