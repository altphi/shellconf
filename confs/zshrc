git_cleanup_branches() {
  git fetch --prune --quiet

  local gone_branches
  gone_branches=$(git branch -vv | grep ': gone]' | awk '{print $1}')

  if [[ -z "$gone_branches" ]]; then
    echo "No local branches with a gone upstream."
    return 0
  fi

  echo "$gone_branches" | xargs git branch -D
}

docker-stop-rm-all () {
  docker rm -f $(docker ps -aq)
  docker network prune -f
  docker volume prune -f
}

docker-compose-rebuild-no-cache () {
  if [ -z "$1" ]; then
    echo "Usage: docker-compose-rebuild-no-cache <all|service>"
    return 1
  fi

  local target="$1"

  if [ "$target" = "all" ]; then
    echo "Rebuilding ALL services..."
    docker compose down -v --rmi all
    docker compose build --no-cache
  else
    if ! docker compose --profile '*' config --services | grep -qx "$target"; then
      echo "Error: Service '$target' not found in docker-compose.yml"
      return 1
    fi

    echo "Rebuilding service: $target"

    docker compose rm -sfv "$target"
    image_id=$(docker compose images -q "$target")
    if [ -n "$image_id" ]; then
      docker image rm "$image_id"
    fi
    docker compose build --no-cache "$target"
  fi
}

