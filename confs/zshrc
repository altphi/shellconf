_fzf_whitelisted_command() {
  emulate -L zsh

  if [[ ! -r "$FZF_COMMANDS_FILE" ]]; then
    zle -M "missing command list: $FZF_COMMANDS_FILE"
    return 0
  fi

  local commands selected
  commands=$(awk 'NF && $1 !~ /^#/ { print }' "$FZF_COMMANDS_FILE")
  if [[ -z "$commands" ]]; then
    zle -M "empty command list: $FZF_COMMANDS_FILE"
    return 0
  fi

  zle -I
  selected=$(print -r -- "$commands" | fzf --height=40% --reverse --query="$BUFFER" --prompt='cmd> ') || {
    zle reset-prompt
    return 0
  }

  [[ -z "$selected" ]] && {
    zle reset-prompt
    return 0
  }

  BUFFER="$selected"
  CURSOR=${#BUFFER}
  zle reset-prompt
}
zle -N _fzf_whitelisted_command
