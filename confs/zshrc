  kill $(ps -u "$USER" -o pid,comm | fzf | awk '{print $1}')
}

edit-zsh-history() {
  local hist=${HISTFILE:-~/.zsh_history}
  local edit=${hist}.edit_me
  local backup=${hist}.bak.$(date +%Y%m%d-%H%M%S)

  fc -W "$hist" || return
  cp -p "$hist" "$edit" || return
  ${EDITOR:-nvim} "$edit" || return

  cp -p "$hist" "$backup" || return
  cp "$edit" "$hist" || return

  fc -p "$hist" "$HISTSIZE" "$SAVEHIST"
  print "Reloaded edited history. Backup: $backup"
}

_diceware() {
  for i in {1..5}; do
    shuf -i 1-6 -n 1 --random-source=/dev/urandom
  done | tr -d '\n'
  echo
}

diceware() {
  p=""
  for i in {1..7}; do
    n=$(_diceware)
    p="${p} $(grep "${n}" ~/.eff_wordlist | cut -f2)"
  done
  echo "$p"
}

