git_cleanup_branches() {
  git fetch --prune --quiet

  local gone_branches
  gone_branches=$(git branch -vv | grep ': gone]' | awk '{print $1}')

  if [[ -z "$gone_branches" ]]; then
    echo "No local branches with a gone upstream."
    return 0
  fi

  echo "$gone_branches" | xargs git branch -D
}

docker-stop-rm-all () {
