#!/usr/bin/env zsh
setopt ALL_EXPORT
readonly SYSTYPE="$(uname)"
PATH="/opt/homebrew/bin:/opt/homebrew/opt/mysql@8.0/bin:/opt/homebrew/opt/mysql-client@8.0/bin:/usr/local/opt/php@7.4/bin:/usr/local/opt/php@7.4/sbin:/opt/homebrew/opt/ruby/bin:$HOME/bin:$HOME/.local/bin:/opt/homebrew/opt/openjdk@21/bin:$PATH"
NODE_PATH="/usr/local/share/npm/lib/node_modules:/usr/local/lib/jsctags/:${NODE_PATH}"
LDFLAGS="-L/usr/local/opt/php@7.4/lib -L/opt/homebrew/opt/mysql-client@8.0/lib"
CPPFLAGS="-I/usr/local/opt/php@7.4/include -I/opt/homebrew/opt/mysql-client@8.0/include"
CLASSPATH="${HOME}/bin/jars/algs4.jar:."

NVM_SYMLINK_CURRENT=true
#NVM_DIR="$HOME/.nvm"
#[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
#[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
#
# for linux
NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" 
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:/opt/X11/lib/pkgconfig

EDITOR=vim
GIT_EDITOR=vim
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

setopt AUTO_CD
setopt CDABLE_VARS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_NO_STORE
setopt nohup
setopt EXTENDED_GLOB
setopt HIST_IGNORE_SPACE
setopt interactivecomments
unset MANPATH
unset PAGER
autoload -Uz compinit && compinit
GREP_OPTIONS='--binary-files=without-match --directories=skip'

# completion
zmodload -i zsh/complist
zstyle ':completion:*' list-colors '$LSCOLORS'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
zstyle ':completion:*' menu select=2

# complete SSH hosts
if test -s "$HOME/.ssh/known_hosts"
then
  local _myhosts
  _myhosts=( ${${${${(f)"$(<$HOME/.ssh/known_hosts)"}:#[0-9]*}%%\ *}%%,*} )
  zstyle ':completion:*' hosts $_myhosts
fi

alias vi='vim'
alias ls=' ls -GF'
alias ll=' ls -lhGF'
alias la=' ls -lahGF'
alias clt2="~/code/clt2"
alias barrage="~/code/barrage"
alias e2e="~/code/e2e"
alias iac="~/code/iac"
alias app2="~/code/app2"
alias abhe="~/code/abhe"
alias backroom="~/code/backroom"
alias kitchensink="~/code/kitchensink"
alias vpn="~/code/clt-vpn-scripts"
alias oldphp="~/code/oldphp"
alias g=' ls -a | xargs grep --color=auto ';
alias ga=' git add'
alias gc=' git checkout'
alias gp=' git pull'
alias gb=' git branch -vv'
alias gba=' git branch -vv --all'
alias gd=' git diff'
alias gbD=' git branch -D '
alias gdf=' git diff --name-only'
alias gs=' git status'
alias gl=' git log --graph --name-status --date=local --pretty=format:"%Cblue%s%Creset / %Cred%h%Creset%n    son of %p / on tree %t / %ad%n    author: %an%n    committer: %cn%n"'
