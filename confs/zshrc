# cursor style
# 1 → blinking block
# 2 → steady block
# 3 → blinking underline
# 4 → steady underline
# 5 → blinking bar (the “stick”)
# 6 → steady bar
function zle-keymap-select zle-line-init {
    if [[ ${KEYMAP} == vicmd ]]; then
        echo -ne '\e[2 q'
    else
        echo -ne '\e[1 q'
    fi
}
