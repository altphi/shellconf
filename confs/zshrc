    left_v="${left_v//$'\e['[0-9;]#[a-zA-Z]/}"
    right_v="${right_v//$'\e['[0-9;]#[a-zA-Z]/}"
    pad=$((COLUMNS - ${#left_v} - ${#right_v}))
    ((pad < 1)) && pad=1
    printf '%s%*s%s' "$left" $pad '' "$right"
  }

