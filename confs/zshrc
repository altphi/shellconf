docker-compose-reset-service_volumes() {
    local svc=${1:?service name}
    local cids vols

    cids=$(docker compose ps -aq "$svc")
    [ -n "$cids" ] || {
      echo "No container found for service: $svc" >&2
      return 1
    }

    vols=$(docker inspect $cids \
      --format '{{range .Mounts}}{{if eq .Type "volume"}}{{println .Name}}{{end}}{{end}}' \
      | sort -u)

    docker compose stop "$svc"
    docker compose rm -sf "$svc"

    [ -n "$vols" ] && echo "$vols" | xargs -r docker volume rm

    docker compose up -d "$svc"
  }


docker-compose-rebuild-no-cache() {
  if [ -z "$1" ]; then
    echo "Usage: docker-compose-rebuild-no-cache <all|service>"
    return 1
  fi

  local target="$1"

  if [ "$target" = "all" ]; then
    echo "Rebuilding ALL services..."
    docker compose down -v --rmi all
    docker compose build --no-cache
  else
    if ! docker compose --profile '*' config --services | grep -qx "$target"; then
      echo "Error: Service '$target' not found in docker-compose.yml"
      return 1
    fi

    echo "Rebuilding service: $target"

    docker compose rm -sfv "$target"
    image_id=$(docker compose images -q "$target")
    if [ -n "$image_id" ]; then
      docker image rm "$image_id"
    fi
    docker compose build --no-cache "$target"
  fi
}

_ddc_brightness_bus() {
  if [[ -n "$DDCUTIL_BRIGHTNESS_BUS" ]]; then
    echo "$DDCUTIL_BRIGHTNESS_BUS"
    return
  fi

  ddcutil detect 2>/dev/null | awk '
    /^Display [0-9]+/ { in_display = 1; next }
    in_display && /I2C bus:/ {
      sub("/dev/i2c-", "", $3)
      print $3
      exit
    }
    /^Invalid display/ { in_display = 0 }
  '
}

hdmi-brightness() {
  # arg 1 is a number between 1-100 for percent of full brightness
  local bus
  bus=$(_ddc_brightness_bus)
  [[ -n "$bus" ]] || return 0

  ddcutil --bus "$bus" setvcp 10 "$1"
}

brightness() {
  if [[ -z "$1" ]]; then
    echo "Built-in: $(brightnessctl -m | awk -F, '{print $4}')"
    local bus
    bus=$(_ddc_brightness_bus)
    [[ -n "$bus" ]] || return 0
    ddcutil --bus "$bus" getvcp 10 2>/dev/null | while read -r line; do
      local val=$(echo "$line" | grep -oP 'current value =\s*\K\d+')
      [[ -n "$val" ]] && echo "HDMI:     ${val}%"
    done
    return
  fi
  hdmi-brightness "$1"
  brightnessctl set "${1}%"
}
