# prevent dangerous commands from entering history
zshaddhistory() {
  local line=${1%%$'\n'}
  if [[ $line =~ "NODE_ENV=production" ]]; then
    return 1
  fi
  if [[ $line =~ "kubectl apply -f .*\bproduction\b.*" ]]; then
    return 1
  fi
  return 0
}

