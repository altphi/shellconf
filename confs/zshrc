docker-compose-rebuild-no-cache () {
  if [ -z "$1" ]; then
    echo "Usage: docker-compose-rebuild-no-cache <all|service>"
    return 1
  fi

  local target="$1"

  if [ "$target" = "all" ]; then
    echo "Rebuilding ALL services..."
    docker compose down -v --rmi all
    docker compose build --no-cache
  else
    if ! docker compose --profile '*' config --services | grep -qx "$target"; then
      echo "Error: Service '$target' not found in docker-compose.yml"
      return 1
    fi

    echo "Rebuilding service: $target"

    docker compose rm -sfv "$target"
    image_id=$(docker compose images -q "$target")
    if [ -n "$image_id" ]; then
      docker image rm "$image_id"
    fi
    docker compose build --no-cache "$target"
  fi
}

hdmi-brightness () {
  # arg 1 is a number between 1-100 for percent of full brightness
  ddcutil setvcp 10 "$1"
}

brightness () {
  if [[ -z "$1" ]]; then
    echo "Built-in: $(brightnessctl -m | awk -F, '{print $4}')"
    ddcutil getvcp 10 2>/dev/null | while read -r line; do
      local val=$(echo "$line" | grep -oP 'current value =\s*\K\d+')
      [[ -n "$val" ]] && echo "HDMI:     ${val}%"
    done
    return
  fi
  hdmi-brightness "$1"
  brightnessctl set "${1}%"
}
