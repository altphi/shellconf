alias info='info --vi-keys'
alias l='ll'
alias lg='ls -lah | grep -i'
alias pg='ps aux | grep -i'
alias rm=' rm -i'
alias find-swp-rm='find . -name ".*swp" -exec rm -v {} \;'
alias d=' dirs `cat .zdirs &>/dev/null` &>/dev/null; dirs -pvl'
alias h=' history 0'
alias sr='rlwrap -r -c -f ~/code/sicp_exercises/etc/completion.txt mit-scheme --load '
alias dnf_search='dnf search '
