[include]
	path = ~/.gitconfig-user
[push]
	default = current
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[core]
	editor = /usr/bin/vi
	excludesfile = /home/stephen/bin/confs/gitignore
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential]
	helper = cache
[http]
	sslVerify = true
[pull]
	rebase = false
[commit]
	template = /home/stephen/.config/git/default-commit-msg
[merge]
	suppressDriveby = false
[init]
	defaultBranch = main
[fetch]
	prune = true
