#!/usr/bin/env sh
  # find-large-searchable — find files >threshold that rg/fd would search
  # Output is .rgignore ready
  threshold=${1:-1048576}  # default 1MB, or pass bytes as $1
  fd --type f --hidden --exclude .git -x stat --printf='%s %n\n' \
    | awk -v t="$threshold" '$1 > t { print substr($0, index($0,$2)) }' \
    | sed 's|^\./||' \
    | sort
